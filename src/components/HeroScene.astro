---
// Cross-section of a flooded room at night: waterline rising, technician
// running an extraction wand, truck-mount hose out the door.
---
<svg class="hero-scene" viewBox="0 0 640 420" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Illustration of a commercial refrigeration technician servicing a walk-in cooler">
  <!-- night sky through window -->
  <rect x="0" y="0" width="640" height="420" fill="#081722"/>
  <!-- room walls -->
  <rect x="30" y="30" width="580" height="330" rx="6" fill="#102a38"/>
  <!-- window with night + rain -->
  <rect x="70" y="70" width="130" height="110" rx="4" fill="#081722" stroke="#1d4456" stroke-width="4"/>
  <line x1="135" y1="70" x2="135" y2="180" stroke="#1d4456" stroke-width="4"/>
  <line x1="70" y1="125" x2="200" y2="125" stroke="#1d4456" stroke-width="4"/>
  <circle cx="100" cy="95" r="9" fill="#f4ead8" opacity="0.85"/>
  <g stroke="#3ec6d8" stroke-width="2" stroke-linecap="round" opacity="0.5">
    <line x1="90" y1="135" x2="85" y2="148"/><line x1="112" y1="140" x2="107" y2="153"/>
    <line x1="155" y1="132" x2="150" y2="145"/><line x1="178" y1="142" x2="173" y2="155"/>
    <line x1="100" y1="158" x2="95" y2="171"/><line x1="165" y1="160" x2="160" y2="173"/>
  </g>
  <!-- picture frame, crooked -->
  <rect x="250" y="80" width="70" height="52" rx="3" fill="#0c2230" stroke="#1d4456" stroke-width="4" transform="rotate(-4 285 106)"/>
  <path d="M262 118 l16 -16 l12 10 l14 -14" stroke="#3ec6d8" stroke-width="3" fill="none" transform="rotate(-4 285 106)" opacity="0.6"/>
  <!-- wall clock reading ~2:30 -->
  <circle cx="420" cy="95" r="26" fill="#0c2230" stroke="#1d4456" stroke-width="4"/>
  <line x1="420" y1="95" x2="420" y2="78" stroke="#eef4f4" stroke-width="3" stroke-linecap="round" transform="rotate(75 420 95)"/>
  <line x1="420" y1="95" x2="420" y2="84" stroke="#eef4f4" stroke-width="3" stroke-linecap="round" transform="rotate(-155 420 95)"/>
  <!-- high water mark label -->
  <g font-family="IBM Plex Mono, monospace" font-size="11" letter-spacing="2" fill="#3ec6d8">
    <text x="474" y="222" opacity="0.9">HIGH WATER</text>
    <line x1="470" y1="230" x2="596" y2="230" stroke="#3ec6d8" stroke-width="1.5" stroke-dasharray="5 5" opacity="0.7"/>
  </g>
  <!-- flood water -->
  <path d="M30 262 q28 -12 56 0 t56 0 t56 0 t56 0 t56 0 t56 0 t56 0 t56 0 t56 0 t56 0 L610 360 L30 360 Z" fill="#155a6b" opacity="0.85"/>
  <path d="M30 268 q28 -10 56 0 t56 0 t56 0 t56 0 t56 0 t56 0 t56 0 t56 0 t56 0 t56 0" stroke="#3ec6d8" stroke-width="3" fill="none"/>
  <path d="M30 292 q28 -8 56 0 t56 0 t56 0 t56 0 t56 0 t56 0 t56 0 t56 0 t56 0 t56 0" stroke="#3ec6d8" stroke-width="2" fill="none" opacity="0.3"/>
  <!-- half-submerged sofa -->
  <g opacity="0.95">
    <rect x="80" y="220" width="150" height="60" rx="12" fill="#1d4456"/>
    <rect x="70" y="235" width="24" height="52" rx="8" fill="#1d4456"/>
    <rect x="216" y="235" width="24" height="52" rx="8" fill="#1d4456"/>
    <rect x="96" y="200" width="118" height="34" rx="10" fill="#255264"/>
  </g>
  <!-- technician -->
  <g>
    <!-- legs in waders -->
    <path d="M392 268 l-6 62 h16 l4 -52 M414 268 l6 62 h-16" fill="#0c2230"/>
    <!-- body: hi-vis vest -->
    <rect x="384" y="196" width="42" height="76" rx="12" fill="#ff5238"/>
    <rect x="384" y="212" width="42" height="9" fill="#ffd23e"/>
    <rect x="384" y="234" width="42" height="9" fill="#ffd23e"/>
    <!-- arms holding wand -->
    <path d="M388 210 q-26 14 -34 46" stroke="#ff5238" stroke-width="12" stroke-linecap="round" fill="none"/>
    <path d="M424 212 q18 18 12 44" stroke="#ff5238" stroke-width="12" stroke-linecap="round" fill="none"/>
    <!-- head + hard hat + headlamp -->
    <circle cx="405" cy="176" r="16" fill="#e8b48c"/>
    <path d="M388 172 a17 17 0 0 1 34 0 l0 4 l-34 0 Z" fill="#ffd23e"/>
    <rect x="386" y="170" width="10" height="7" rx="2" fill="#eef4f4"/>
    <path d="M386 174 l-34 22" stroke="#f4ead8" stroke-width="3" opacity="0.35" stroke-linecap="round"/>
    <!-- extraction wand into the water -->
    <path d="M352 254 L330 300" stroke="#93abb4" stroke-width="9" stroke-linecap="round"/>
    <rect x="318" y="296" width="30" height="12" rx="4" fill="#93abb4"/>
    <!-- hose from wand out the door -->
    <path d="M352 254 q40 -60 110 -44 q80 18 120 -14 l28 -22" stroke="#3ec6d8" stroke-width="8" fill="none" stroke-linecap="round" opacity="0.9"/>
  </g>
  <!-- open doorway on right with truck glow -->
  <rect x="560" y="120" width="50" height="240" fill="#081722"/>
  <rect x="560" y="120" width="50" height="240" stroke="#1d4456" stroke-width="4"/>
  <circle cx="606" cy="180" r="34" fill="#ff5238" opacity="0.18"/>
  <circle cx="612" cy="182" r="12" fill="#ff5238" opacity="0.55"/>
  <!-- extraction ripples around wand -->
  <g stroke="#eef4f4" stroke-width="2" fill="none" opacity="0.5">
    <path d="M310 302 q22 -8 44 0"/>
    <path d="M302 312 q30 -10 60 0"/>
  </g>
  <!-- floating debris -->
  <rect x="150" y="286" width="34" height="10" rx="3" fill="#255264"/>
  <circle cx="270" cy="290" r="5" fill="#255264"/>
</svg>

<style>
  .hero-scene {
    width: 100%; height: auto; display: block;
    border-radius: 20px;
    border: 1px solid rgba(14, 36, 51, 0.12);
    box-shadow: 0 24px 64px rgba(14, 36, 51, 0.22);
  }
</style>
